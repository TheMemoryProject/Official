# Supabase Database URL (Transaction pooler mode for Prisma)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/ktn_db?schema=public&pgbouncer=true"

# Direct URL for Prisma migrations (Session mode)
DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/ktn_db?schema=public"

# Supabase Auth & Storage Settings
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# JWT Secret for fallback auth verification
JWT_SECRET="ktn-production-verification-first-secret-key-32chars"

# App Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
