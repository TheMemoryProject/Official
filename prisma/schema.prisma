// ============================================================================
// KNOWLEDGE EVOLUTION & CONTINUOUS REVALIDATION
//
// Engineering knowledge is not static. A verified conclusion depends on the
// standards, materials, processes, suppliers, and evidence that were true when
// it was verified. When any of those change, the conclusion may no longer hold.
//
// These models make that dependency explicit, make impact propagation
// deterministic and replayable, and preserve an immutable record of why every
// status change happened.
// ============================================================================

enum DependencyKind {
  STANDARD
  MATERIAL
  PROCESS
  SUPPLIER
  EVIDENCE
  KNOWLEDGE
  ENVIRONMENT
  REGULATION
  EXPERT
}

enum DependencyCriticality {
  BLOCKING // conclusion cannot stand if this changes
  MAJOR    // conclusion likely affected; needs review
  MINOR    // informational; note but do not gate
}

enum ChangeEventType {
  STANDARD_REVISED
  STANDARD_WITHDRAWN
  MATERIAL_SPEC_CHANGED
  PROCESS_CHANGED
  SUPPLIER_CHANGED
  EVIDENCE_SUPERSEDED
  EVIDENCE_RETRACTED
  FIELD_FAILURE_REPORTED
  REGULATION_PUBLISHED
  KNOWLEDGE_SUPERSEDED
  EXPERT_DEPARTED
}

enum ChangeEventStatus {
  DETECTED
  PROPAGATED
  DISMISSED
}

enum CurrencyStatus {
  CURRENT
  REVALIDATION_REQUIRED
  UNDER_REVALIDATION
  SUPERSEDED
  RETIRED
}

enum RevalidationTaskStatus {
  OPEN
  ASSIGNED
  IN_REVIEW
  RESOLVED_CONFIRMED
  RESOLVED_AMENDED
  RESOLVED_RETIRED
  DISMISSED
}

/// A declared dependency from a knowledge object onto something that can change.
/// `targetId` is set when the dependency points at a row in this database;
/// `targetIdentifier` carries the external identity (e.g. "ISO 9001", "AMS 4928")
/// and is what change events match on.
model KnowledgeDependency {
  id               String                @id @default(uuid()) @db.Uuid
  knowledgeId      String                @db.Uuid
  kind             DependencyKind
  targetId         String?               @db.Uuid
  targetIdentifier String
  pinnedRevision   String?
  criticality      DependencyCriticality @default(MAJOR)
  rationale        String?
  declaredById     String?               @db.Uuid
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  knowledge        KnowledgeEntry        @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  declaredBy       User?                 @relation("DependencyDeclarer", fields: [declaredById], references: [id])

  @@unique([knowledgeId, kind, targetIdentifier])
  @@index([kind, targetIdentifier])
  @@index([knowledgeId])
}

/// Something changed in the world. Recorded once, propagated deterministically.
model ChangeEvent {
  id                 String             @id @default(uuid()) @db.Uuid
  type               ChangeEventType
  dependencyKind     DependencyKind
  subjectId          String?            @db.Uuid
  subjectIdentifier  String
  fromRevision       String?
  toRevision         String?
  summary            String
  sourceUrl          String?
  detectedAt         DateTime           @default(now())
  detectedById       String?            @db.Uuid
  status             ChangeEventStatus  @default(DETECTED)
  propagatedAt       DateTime?
  engineVersion      String?
  createdAt          DateTime           @default(now())

  detectedBy         User?              @relation("ChangeEventDetector", fields: [detectedById], references: [id])
  impacts            ImpactAssessment[]
  tasks              RevalidationTask[]
  statusHistory      KnowledgeStatusHistory[]

  @@index([dependencyKind, subjectIdentifier])
  @@index([status])
  @@index([detectedAt])
}

/// Immutable audit record: this change event impacted this knowledge object,
/// via this dependency, at this criticality. One row per (event, knowledge).
model ImpactAssessment {
  id             String                @id @default(uuid()) @db.Uuid
  changeEventId  String                @db.Uuid
  knowledgeId    String                @db.Uuid
  dependencyId   String?               @db.Uuid
  criticality    DependencyCriticality
  previousStatus CurrencyStatus
  newStatus      CurrencyStatus
  pathJson       String
  engineVersion  String
  createdAt      DateTime              @default(now())

  changeEvent    ChangeEvent           @relation(fields: [changeEventId], references: [id], onDelete: Cascade)
  knowledge      KnowledgeEntry        @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)

  @@unique([changeEventId, knowledgeId])
  @@index([knowledgeId])
}

/// Human work item created when impact requires re-verification.
model RevalidationTask {
  id                  String                 @id @default(uuid()) @db.Uuid
  knowledgeId         String                 @db.Uuid
  changeEventId       String?                @db.Uuid
  status              RevalidationTaskStatus @default(OPEN)
  criticality         DependencyCriticality
  reason              String
  assigneeId          String?                @db.Uuid
  openedAt            DateTime               @default(now())
  resolvedAt          DateTime?
  resolvedById        String?                @db.Uuid
  resolutionRationale String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  knowledge           KnowledgeEntry         @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  changeEvent         ChangeEvent?           @relation(fields: [changeEventId], references: [id], onDelete: SetNull)
  assignee            User?                  @relation("RevalidationAssignee", fields: [assigneeId], references: [id])
  resolvedBy          User?                  @relation("RevalidationResolver", fields: [resolvedById], references: [id])

  @@index([status])
  @@index([knowledgeId])
  @@index([assigneeId])
}

/// Current computed currency of a knowledge object. Fully derived: every field
/// here can be reproduced by recomputeCurrency() from the rows above. Drift is
/// a build failure.
model KnowledgeCurrency {
  id                 String         @id @default(uuid()) @db.Uuid
  knowledgeId        String         @unique @db.Uuid
  status             CurrencyStatus @default(CURRENT)
  currencyScore      Int
  decayComponent     Int
  impactComponent    Int
  openTaskCount      Int            @default(0)
  blockingTaskCount  Int            @default(0)
  ageDays            Int            @default(0)
  lastRevalidatedAt  DateTime?
  breakdownJson      String
  engineVersion      String
  computedAt         DateTime       @default(now())

  knowledge          KnowledgeEntry @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([currencyScore])
}

/// Immutable, append-only record of why a knowledge object changed currency status.
model KnowledgeStatusHistory {
  id            String          @id @default(uuid()) @db.Uuid
  knowledgeId   String          @db.Uuid
  fromStatus    CurrencyStatus?
  toStatus      CurrencyStatus
  reason        String
  changeEventId String?         @db.Uuid
  taskId        String?         @db.Uuid
  actorId       String?         @db.Uuid
  engineVersion String
  createdAt     DateTime        @default(now())

  knowledge     KnowledgeEntry  @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  changeEvent   ChangeEvent?    @relation(fields: [changeEventId], references: [id], onDelete: SetNull)
  actor         User?           @relation("StatusHistoryActor", fields: [actorId], references: [id])

  @@index([knowledgeId, createdAt])
  @@index([changeEventId])
}
