generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SystemRole {
  ADMIN
  VERIFIER
  CONTRIBUTOR
  ENGINEER
  VIEWER
}

enum VerificationStatus {
  UNVERIFIED
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_CHANGES
  REJECTED
  VERIFIED
  ARCHIVED
}

enum ProblemSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  BLOCKER
}

enum KnowledgeVisibility {
  PUBLIC
  ORGANIZATION
  PRIVATE
}

enum RelationshipType {
  SOLVES
  SIMILAR_TO
  RELATED_TO
  USES
  REQUIRES
  GENERATED_BY
  SUPPORTED_BY
  CONTRADICTED_BY
  SUPERSEDES
  PREVENTS
  CAUSES
  FAILED_BECAUSE_OF
  TESTED_BY
  VERIFIED_BY
  REFERENCES
  DERIVED_FROM
  MANUFACTURED_WITH
  APPLIES_TO
  CERTIFIED_BY
  MITIGATED_BY
  GOVERNED_BY
  COMPLIES_WITH
  VIOLATES
}

enum GraphNodeType {
  KNOWLEDGE_ENTRY
  ENGINEERING_PROBLEM
  SOLUTION
  FAILURE
  EVIDENCE
  DOMAIN
  INDUSTRY
  TECHNOLOGY
  MATERIAL
  MANUFACTURING_PROCESS
  COMPONENT
  SUBSYSTEM
  SYSTEM
  PHYSICAL_PHENOMENON
  FAILURE_MODE
  CONSTRAINT
  ENGINEERING_STANDARD
  PATENT
  RESEARCH_PAPER
  ORGANIZATION
  CONTRIBUTOR
}

enum EvidenceType {
  TEST_REPORT
  QUALIFICATION_REPORT
  CERTIFICATION_RECORD
  LAB_RESULT
  PEER_REVIEWED_PAPER
  SIMULATION_FEA_CFD
  INSPECTION_REPORT
  MATERIAL_DATASHEET
  ENGINEERING_STANDARD
  PATENT
  PROTOTYPE_RESULT
  PRODUCTION_DATA
}

enum TranslationCategory {
  FUNCTION_TRANSFER
  FAILURE_TRANSFER
  MATERIAL_TRANSFER
  MANUFACTURING_TRANSFER
  THERMAL_TRANSFER
  STRUCTURAL_TRANSFER
  RELIABILITY_TRANSFER
  LESSONS_LEARNED
}

enum DocumentProcessingStatus {
  UPLOADED
  PROCESSING
  EXTRACTED
  NEEDS_REVIEW
  APPROVED
  FAILED
}

enum ExtractedEntityType {
  PROBLEM
  SOLUTION
  FAILURE_MODE
  MATERIAL
  MANUFACTURING_PROCESS
  PHYSICAL_PHENOMENON
  CONSTRAINT
  LESSONS_LEARNED
  STANDARD
  CORRECTIVE_ACTION
}

enum StandardStatus {
  ACTIVE
  SUPERSEDED
  DRAFT
  UNDER_REVISION
  WITHDRAWN
  ARCHIVED
}

enum StandardHierarchyType {
  CHAPTER
  SECTION
  SUBSECTION
  REQUIREMENT
  CLAUSE
  PARAGRAPH
  FIGURE
  TABLE
}

enum ComplianceStatus {
  COMPLIANT
  NON_COMPLIANT
  PARTIALLY_COMPLIANT
  UNDER_REVIEW
  MISSING_EVIDENCE
  NOT_APPLICABLE
}

enum DecisionStatus {
  DRAFT
  DISCUSSION
  TECHNICAL_REVIEW
  APPROVAL
  PUBLISHED
  SUPERSEDED
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  TECHNICAL_REVIEW
  DONE
  BLOCKED
}

enum ConnectorType {
  PLM_WINDCHILL
  PLM_TEAMCENTER
  ERP_SAP
  QMS_TRACKWISE
  GIT_GITHUB
  REST_API
  WEBHOOK
  CSV_EXCEL
  DATABASE_SQL
}

enum ConnectorStatus {
  ACTIVE
  INACTIVE
  PAUSED
  ERROR
}

enum ConnectorHealth {
  HEALTHY
  WARNING
  UNHEALTHY
}

enum SyncJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id               String               @id @default(uuid()) @db.Uuid
  email            String               @unique
  passwordHash     String
  fullName         String
  title            String?
  avatarUrl        String?
  role             SystemRole           @default(ENGINEER)
  organizationId   String?              @db.Uuid
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?

  organization     Organization?        @relation("PrimaryOrganization", fields: [organizationId], references: [id])
  memberships      OrganizationMember[]
  createdProblems  EngineeringProblem[] @relation("ProblemCreator")
  createdSolutions VerifiedSolution[]   @relation("SolutionCreator")
  verifiedSolutions VerifiedSolution[]  @relation("SolutionVerifier")
  evidences        Evidence[]           @relation("EvidenceUploader")

  createdKnowledge KnowledgeEntry[]     @relation("KnowledgeContributor")
  reviewedKnowledge KnowledgeEntry[]    @relation("KnowledgeReviewer")
  bookmarks        Bookmark[]
  bookmarkFolders  BookmarkFolder[]
  savedSearches    SavedSearch[]
  searchHistory    SearchHistoryItem[]
  recentlyViewed   RecentlyViewedItem[]
  notifications    Notification[]
  createdFailures  FailureRecord[]      @relation("FailureContributor")
  reviewedFailures FailureRecord[]      @relation("FailureVerifier")
  createdEvidenceRecords EvidenceRecord[] @relation("EvidenceRecordContributor")
  reviewedEvidenceRecords EvidenceRecord[] @relation("EvidenceRecordVerifier")
  ingestedDocs     IngestedDocument[]   @relation("DocContributor")

  createdStandards StandardRecord[]     @relation("StandardContributor")
  reviewedStandards StandardRecord[]    @relation("StandardReviewer")
  reviewedComplianceMappings ComplianceMapping[] @relation("ComplianceReviewer")

  createdDecisions EngineeringDecision[] @relation("DecisionOwner")
  createdTasks     EngineeringTask[]     @relation("TaskReporter")
  assignedTasks    EngineeringTask[]     @relation("TaskAssignee")
  activityLogs     ActivityLog[]
  watchedItems     ItemWatch[]

  connectors       IntegrationConnector[] @relation("ConnectorOwner")
  savedReports     SavedReport[]          @relation("ReportAuthor")
  apiKeys          ApiKey[]               @relation("ApiKeyOwner")
  conversations    EngineeringConversation[] @relation("ConversationUser")

  changeRequests   KnowledgeChangeRequest[] @relation("RequestRequester")
  reviewedRequests KnowledgeChangeRequest[] @relation("RequestReviewer")
  publishedReleases KnowledgeRelease[]      @relation("ReleasePublisher")
  subscriptions    KnowledgeSubscription[]

  portfolios       EngineeringPortfolio[] @relation("PortfolioOwner")
  programs         EngineeringProgram[]   @relation("ProgramOwner")
  projects         EngineeringProject[]   @relation("ProjectOwner")
  developerApps    DeveloperApp[]         @relation("AppOwner")
  incidents        SystemIncident[]       @relation("IncidentOwner")

  // Knowledge Evolution & Continuous Revalidation
  declaredDependencies KnowledgeDependency[]    @relation("DependencyDeclarer")
  detectedChanges      ChangeEvent[]            @relation("ChangeEventDetector")
  assignedRevalidations RevalidationTask[]      @relation("RevalidationAssignee")
  resolvedRevalidations RevalidationTask[]      @relation("RevalidationResolver")
  statusHistoryActions  KnowledgeStatusHistory[] @relation("StatusHistoryActor")

  @@index([email])
  @@index([role])
  @@index([organizationId])
}

model Organization {
  id                String               @id @default(uuid()) @db.Uuid
  name              String
  slug              String               @unique
  description       String?
  logoUrl           String?
  subscriptionTier  String               @default("ENTERPRISE") // COMMUNITY, PROFESSIONAL, ENTERPRISE
  region            String               @default("US-EAST")
  storageUsageMb    Float                @default(128.5)
  retentionDays     Int                  @default(365)
  securitySettingsJson String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?

  primaryUsers      User[]              @relation("PrimaryOrganization")
  members           OrganizationMember[]
  problems          EngineeringProblem[]
  solutions         VerifiedSolution[]
  knowledge         KnowledgeEntry[]
  failures          FailureRecord[]
  evidenceRecords   EvidenceRecord[]
  ingestedDocs      IngestedDocument[]
  standards         StandardRecord[]
  decisions         EngineeringDecision[]
  tasks             EngineeringTask[]
  connectors        IntegrationConnector[]
  apiKeys           ApiKey[]
  auditLogs         SecurityAuditLog[]
  portfolios        EngineeringPortfolio[]
  projects          EngineeringProject[]
  automationRules   AutomationRule[]
  developerApps     DeveloperApp[]
  governancePolicies GovernancePolicy[]
  integrityReports  IntegrityReport[]
  marketplaceListings MarketplaceListing[]
  partnerRequests   OrgPartnership[]      @relation("RequesterOrg")
  partnerAccepts    OrgPartnership[]      @relation("PartnerOrg")
  leadConsortiums   EngineeringConsortium[] @relation("LeadOrg")

  @@index([slug])
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  role           SystemRole   @default(ENGINEER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model EngineeringDomain {
  id          String               @id @default(uuid()) @db.Uuid
  name        String               @unique
  code        String               @unique
  description String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  problems    EngineeringProblem[]
  solutions   VerifiedSolution[]
  knowledge   KnowledgeEntry[]
  failures    FailureRecord[]
  evidenceRecords EvidenceRecord[]
  standards   StandardRecord[]
  decisions   EngineeringDecision[]
  projects    EngineeringProject[]
}

model Industry {
  id          String               @id @default(uuid()) @db.Uuid
  name        String               @unique
  code        String               @unique
  description String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  problems    EngineeringProblem[]
  solutions   VerifiedSolution[]
  knowledge   KnowledgeEntry[]
  failures    FailureRecord[]
  evidenceRecords EvidenceRecord[]
  standards   StandardRecord[]
  decisions   EngineeringDecision[]
  projects    EngineeringProject[]
}

model EngineeringProblem {
  id             String             @id @default(uuid()) @db.Uuid
  title          String
  description    String
  severity       ProblemSeverity    @default(MEDIUM)
  domainId       String             @db.Uuid
  industryId     String             @db.Uuid
  organizationId String?            @db.Uuid
  creatorId      String             @db.Uuid
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  domain         EngineeringDomain  @relation(fields: [domainId], references: [id])
  industry       Industry           @relation(fields: [industryId], references: [id])
  organization   Organization?      @relation(fields: [organizationId], references: [id])
  creator        User               @relation("ProblemCreator", fields: [creatorId], references: [id])
  solutions      VerifiedSolution[]

  @@index([domainId])
  @@index([industryId])
  @@index([creatorId])
  @@index([organizationId])
}

model VerifiedSolution {
  id                  String             @id @default(uuid()) @db.Uuid
  problemId           String             @db.Uuid
  title               String
  summary             String
  solutionDetails     String
  verificationStatus  VerificationStatus @default(UNVERIFIED)
  verificationNotes   String?
  knownLimitations    String?
  organizationId      String?            @db.Uuid
  domainId            String             @db.Uuid
  industryId          String             @db.Uuid
  creatorId           String             @db.Uuid
  verifierId          String?            @db.Uuid
  verifiedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  problem             EngineeringProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  domain              EngineeringDomain  @relation(fields: [domainId], references: [id])
  industry            Industry           @relation(fields: [industryId], references: [id])
  organization        Organization?      @relation(fields: [organizationId], references: [id])
  creator             User               @relation("SolutionCreator", fields: [creatorId], references: [id])
  verifier            User?              @relation("SolutionVerifier", fields: [verifierId], references: [id])

  evidences           Evidence[]
  failures            FailureRecord[]
  references          SolutionReference[]
  tags                SolutionTag[]
  sourceRelations     RelatedSolution[]   @relation("SourceSolution")
  targetRelations     RelatedSolution[]   @relation("TargetSolution")

  @@index([problemId])
  @@index([verificationStatus])
  @@index([creatorId])
  @@index([verifierId])
  @@index([domainId])
  @@index([industryId])
}

model Evidence {
  id          String           @id @default(uuid()) @db.Uuid
  solutionId  String           @db.Uuid
  title       String
  description String
  fileUrl     String
  fileType    String
  uploaderId  String           @db.Uuid
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  solution    VerifiedSolution @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  uploader    User             @relation("EvidenceUploader", fields: [uploaderId], references: [id])

  @@index([solutionId])
}

model Tag {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @unique
  createdAt DateTime      @default(now())

  solutions SolutionTag[]
}

model SolutionTag {
  solutionId String           @db.Uuid
  tagId      String           @db.Uuid

  solution   VerifiedSolution @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  tag        Tag              @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([solutionId, tagId])
}

model SolutionReference {
  id         String           @id @default(uuid()) @db.Uuid
  solutionId String           @db.Uuid
  title      String
  url        String?
  citation   String?
  createdAt  DateTime         @default(now())

  solution   VerifiedSolution @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  @@index([solutionId])
}

model RelatedSolution {
  sourceSolutionId String           @db.Uuid
  targetSolutionId String           @db.Uuid
  relationshipType String           @default("DEPENDS_ON")

  sourceSolution   VerifiedSolution @relation("SourceSolution", fields: [sourceSolutionId], references: [id], onDelete: Cascade)
  targetSolution   VerifiedSolution @relation("TargetSolution", fields: [targetSolutionId], references: [id], onDelete: Cascade)

  @@id([sourceSolutionId, targetSolutionId])
}

model KnowledgeEntry {
  id                   String              @id @default(uuid()) @db.Uuid
  title                String
  problemSummary       String
  detailedProblem      String
  solutionSummary      String
  technicalExplanation String
  knownConstraints     String?
  failureModes         String?
  lessonsLearned       String?
  benefits             String?
  tradeoffs            String?
  implementationSteps  String?
  verificationStatus   VerificationStatus  @default(DRAFT)
  confidenceScore      Int                 @default(85)
  difficultyLevel      Int                 @default(3)
  viewCount            Int                 @default(0)
  bookmarkCount        Int                 @default(0)
  readingTimeMinutes   Int                 @default(5)
  version              Int                 @default(1)
  visibility           KnowledgeVisibility @default(PUBLIC)
  verificationNotes    String?
  domainId             String              @db.Uuid
  industryId           String              @db.Uuid
  organizationId       String?             @db.Uuid
  creatorId            String              @db.Uuid
  reviewerId           String?             @db.Uuid
  projectId            String?             @db.Uuid
  verifiedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?

  domain               EngineeringDomain   @relation(fields: [domainId], references: [id])
  industry             Industry            @relation(fields: [industryId], references: [id])
  organization         Organization?       @relation(fields: [organizationId], references: [id])
  creator              User                @relation("KnowledgeContributor", fields: [creatorId], references: [id])
  reviewer             User?               @relation("KnowledgeReviewer", fields: [reviewerId], references: [id])
  project              EngineeringProject? @relation(fields: [projectId], references: [id])

  versions             KnowledgeVersion[]
  attachments          KnowledgeAttachment[]
  comments             KnowledgeComment[]
  bookmarks            Bookmark[]
  recentlyViewed       RecentlyViewedItem[]
  sourceTranslations   KnowledgeTranslation[] @relation("SourceKnowledge")
  targetTranslations   KnowledgeTranslation[] @relation("TargetKnowledge")
  complianceMappings   ComplianceMapping[]
  decisions            EngineeringDecision[]
  tasks                EngineeringTask[]
  changeRequests       KnowledgeChangeRequest[]
  qualityScores        KnowledgeQualityScore[]

  // Knowledge Evolution & Continuous Revalidation
  dependencies         KnowledgeDependency[]
  impactAssessments    ImpactAssessment[]
  revalidationTasks    RevalidationTask[]
  currency             KnowledgeCurrency?
  statusHistory        KnowledgeStatusHistory[]

  @@index([verificationStatus])
  @@index([domainId])
  @@index([industryId])
  @@index([creatorId])
  @@index([confidenceScore])
}

model KnowledgeVersion {
  id                   String         @id @default(uuid()) @db.Uuid
  knowledgeEntryId     String         @db.Uuid
  version              Int
  title                String
  problemSummary       String
  solutionSummary      String
  technicalExplanation String
  editorId             String         @db.Uuid
  changeSummary        String?
  snapshotJson         String
  createdAt            DateTime       @default(now())

  knowledgeEntry       KnowledgeEntry @relation(fields: [knowledgeEntryId], references: [id], onDelete: Cascade)

  @@index([knowledgeEntryId])
}

model KnowledgeAttachment {
  id               String         @id @default(uuid()) @db.Uuid
  knowledgeEntryId String         @db.Uuid
  title            String
  fileUrl          String
  fileName         String
  fileType         String
  fileSize         Int
  uploaderId       String         @db.Uuid
  createdAt        DateTime       @default(now())

  knowledgeEntry   KnowledgeEntry @relation(fields: [knowledgeEntryId], references: [id], onDelete: Cascade)

  @@index([knowledgeEntryId])
}

model KnowledgeComment {
  id               String             @id @default(uuid()) @db.Uuid
  knowledgeEntryId String             @db.Uuid
  parentCommentId  String?            @db.Uuid
  authorId         String             @db.Uuid
  content          String
  isResolved       Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  knowledgeEntry   KnowledgeEntry     @relation(fields: [knowledgeEntryId], references: [id], onDelete: Cascade)
  parentComment    KnowledgeComment?  @relation("ThreadedComment", fields: [parentCommentId], references: [id])
  replies          KnowledgeComment[] @relation("ThreadedComment")

  @@index([knowledgeEntryId])
}

model BookmarkFolder {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  color     String     @default("#3b82f6")
  userId    String     @db.Uuid
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmarks Bookmark[]

  @@index([userId])
}

model Bookmark {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @db.Uuid
  knowledgeEntryId String          @db.Uuid
  folderId         String?         @db.Uuid
  notes            String?
  createdAt        DateTime        @default(now())

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeEntry   KnowledgeEntry  @relation(fields: [knowledgeEntryId], references: [id], onDelete: Cascade)
  folder           BookmarkFolder? @relation(fields: [folderId], references: [id])

  @@unique([userId, knowledgeEntryId])
  @@index([userId])
}

model SavedSearch {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  name        String
  query       String
  filtersJson String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SearchHistoryItem {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  query       String
  filtersJson String
  resultCount Int      @default(0)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RecentlyViewedItem {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @db.Uuid
  knowledgeEntryId String         @db.Uuid
  viewedAt         DateTime       @default(now())

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeEntry   KnowledgeEntry @relation(fields: [knowledgeEntryId], references: [id], onDelete: Cascade)

  @@unique([userId, knowledgeEntryId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String
  message   String
  type      String   @default("INFO")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TaxonomyCategory {
  id          String             @id @default(uuid()) @db.Uuid
  name        String
  code        String             @unique
  type        String             // MATERIAL, PROCESS, FAILURE_MODE, PHENOMENON, TECHNOLOGY, COMPONENT
  parentId    String?            @db.Uuid
  description String?
  createdAt   DateTime           @default(now())

  parent      TaxonomyCategory?  @relation("TaxonomyHierarchy", fields: [parentId], references: [id])
  children    TaxonomyCategory[] @relation("TaxonomyHierarchy")

  @@index([type])
}

model StructuredProblem {
  id                String   @id @default(uuid()) @db.Uuid
  title             String
  objective         String
  system            String
  subsystem         String
  component         String
  primaryFunction   String
  secondaryFunction String?
  failureMode       String
  phenomenon        String
  rootCause         String
  operatingTempMin  Float?
  operatingTempMax  Float?
  pressureMax       Float?
  loadType          String?
  materialFamily    String?
  process           String?
  reliabilityReq    String?
  creatorId         String   @db.Uuid
  createdAt         DateTime @default(now())

  @@index([creatorId])
}

model FailureRecord {
  id                 String             @id @default(uuid()) @db.Uuid
  title              String
  summary            String
  description        String
  category           String
  failureType        String
  subsystem          String
  component          String
  affectedProduct    String?
  phenomenon         String
  rootCause          String
  immediateCause     String
  contributingFactors String?
  operatingConditions String?
  material           String?
  process            String?
  supplier           String?
  testingMethod      String?
  detectionMethod    String?
  severity           Int                @default(5)
  occurrence         Int                @default(5)
  detectability      Int                @default(5)
  rpn                Int                @default(125)
  financialCost      Float?
  scheduleImpactDays Int?
  safetyImpact       String?
  correctiveActions  String
  preventiveActions  String
  lessonsLearned     String
  fiveWhysJson       String?
  fishboneJson       String?
  verificationStatus VerificationStatus @default(DRAFT)
  domainId           String             @db.Uuid
  industryId         String             @db.Uuid
  organizationId     String?            @db.Uuid
  contributorId      String             @db.Uuid
  verifierId         String?            @db.Uuid
  verifiedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  domain             EngineeringDomain  @relation(fields: [domainId], references: [id])
  industry           Industry           @relation(fields: [industryId], references: [id])
  organization       Organization?      @relation(fields: [organizationId], references: [id])
  contributor        User               @relation("FailureContributor", fields: [contributorId], references: [id])
  verifier           User?              @relation("FailureVerifier", fields: [verifierId], references: [id])

  verifiedSolution   VerifiedSolution?  @relation(fields: [verifiedSolutionId], references: [id])
  verifiedSolutionId String?            @db.Uuid

  complianceMappings ComplianceMapping[]
  decisions          EngineeringDecision[]
  tasks              EngineeringTask[]

  @@index([rpn])
  @@index([verificationStatus])
  @@index([domainId])
  @@index([industryId])
}

model EvidenceRecord {
  id                   String             @id @default(uuid()) @db.Uuid
  title                String
  summary              String
  description          String
  evidenceType         EvidenceType       @default(TEST_REPORT)
  source               String
  documentNumber       String?
  revision             String?
  author               String?
  publicationDate      DateTime?
  doi                  String?
  patentNumber         String?
  standardsRef         String?
  certificationRef     String?
  confidenceLevel      String             @default("HIGH")
  evidenceStrengthScore Int               @default(85)
  accessLevel          KnowledgeVisibility @default(PUBLIC)
  fileUrl              String?
  externalUrl          String?
  verificationStatus   VerificationStatus @default(DRAFT)
  domainId             String             @db.Uuid
  industryId           String             @db.Uuid
  organizationId       String?            @db.Uuid
  contributorId        String             @db.Uuid
  verifierId           String?            @db.Uuid
  verifiedAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?

  domain               EngineeringDomain  @relation(fields: [domainId], references: [id])
  industry             Industry           @relation(fields: [industryId], references: [id])
  organization         Organization?      @relation(fields: [organizationId], references: [id])
  contributor          User               @relation("EvidenceRecordContributor", fields: [contributorId], references: [id])
  verifier             User?              @relation("EvidenceRecordVerifier", fields: [verifierId], references: [id])

  complianceMappings   ComplianceMapping[]
  decisions            EngineeringDecision[]
  tasks                EngineeringTask[]

