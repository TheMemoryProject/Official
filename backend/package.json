{
  "name": "ktn-debkg-backend",
  "version": "1.0.0",
  "private": true,
  "description": "KTN DEBKG API — Fastify + PostgreSQL, dual-number AD optimisation engine",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:core": "tsx src/domain-core/selfCheck.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "pg": "^8.12.0",
    "pino": "^9.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.0",
    "pino-pretty": "^11.2.2",
    "typescript": "^5.5.4"
  }
}
